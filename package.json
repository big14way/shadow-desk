{
  "name": "shadow-desk",
  "version": "0.1.0",
  "private": true,
  "description": "A peer-to-peer ZEC desk where the price is public and the participants are not.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"DESK_DRY_RUN=1 tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "demo": "vite build && DESK_DRY_RUN=1 tsx src/server/main.ts",
    "arbiter": "tsx scripts/arbiter.ts",
    "spike": "bash scripts/spike-local.sh",
    "spike:mainnet": "tsx scripts/spike-mainnet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "hono": "^4.13.13",
    "libsodium-wrappers": "^0.8.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  }
}
