# Shadow Desk configuration. Copy to .env (never committed) or set in the systemd unit.

# --- Mode
# DESK_DRY_RUN=1            # mocks zwatch and the signing worker; refused when NODE_ENV=production
NODE_ENV=production
ZCASH_NETWORK=main          # main | test (dry run defaults to test)

# --- HTTP
HOST=127.0.0.1              # nginx terminates TLS in front of this
PORT=8787

# --- Storage (all private: the process runs with umask 077)
DATA_DIR=/var/lib/shadow-desk          # holds desk.sqlite, frost/, wallets/, work/
# DB_PATH=/var/lib/shadow-desk/desk.sqlite
# FROST_DIR=/var/lib/shadow-desk/frost  # per-trade arbiter frost-client configs (key shares!)

# --- FROST
FROSTD_URL=frost.example.com:443       # host:port as frost-client's --server-url expects it

# --- Zcash
ZWATCH_URL=http://127.0.0.1:8790       # zwatch (Ghostpass); see docs/ZWATCH.md
# ZWATCH_TOKEN=
LIGHTWALLETD=zecrocks                  # zcash-devtool -s
ZCASH_CONNECTION=direct                # or tor: broadcast and sync through zcash-devtool's Tor client

# --- Arbiter (generate with: pnpm arbiter token / pnpm arbiter box-keypair)
ARBITER_TOKEN_HASH=
ARBITER_BOX_PUBKEY=
# ARBITER_BOX_SECRET is never set on the server.

# --- Tape
TAPE_MAX_DELAY_MS=3600000              # random publication delay, 0–60 min

# --- Tool paths (default: from PATH)
# FROST_CLIENT_BIN=/usr/local/bin/frost-client
# ZCASH_SIGN_BIN=/usr/local/bin/zcash-sign
# ZCASH_DEVTOOL_BIN=/usr/local/bin/zcash-devtool
