[Unit]
Description=frostd (FROST relay for Shadow Desk)
After=network-online.target

[Service]
User=frostd
ExecStart=/usr/local/bin/frostd --ip 127.0.0.1 --port 2744 --no-tls-very-insecure
Restart=always
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
